# Local single-provider Google OIDC example. Production creates this file
# from server-side environment variables during container startup.
# Never commit real values. Production redirect_uri must use HTTPS.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = []
